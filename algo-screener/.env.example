# ============================================================================
# Vercel import file — Settings -> Environment Variables -> paste / import.
# Apply to: Production, Preview, Development.
# NOT committed: the repo's .gitignore excludes .env*
# ============================================================================

# --- Durable state (REQUIRED) ----------------------------------------------
# Without these the app falls back to in-memory storage and every serverless
# invocation starts blank. That is the "dummy data" symptom.
UPSTASH_REDIS_REST_URL=https://summary-herring-219162.upstash.io
UPSTASH_REDIS_REST_TOKEN=gQAAAAAAA1gaAAIgcDJhNzA1YmFjMGZkMzg0ZWM4YjY0MmZkOWY1MGYxMWJjNw

# --- Scheduler auth (REQUIRED) ---------------------------------------------
# Vercel Cron sends this automatically as `Authorization: Bearer <value>`.
# Use the SAME value for the GitHub Actions CRON_SECRET secret.
CRON_SECRET=IAZWXZjcH3rRF4Wb8BFKWZ7rHaUh9hpBzAzkAk8M

# --- LLM strategy improvement ----------------------------------------------
OPENROUTER_API_KEY=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
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free
# Each model gets this long before failover; the whole round gets LLM_BUDGET_MS.
# Both must leave headroom inside Vercel's 60s function limit.
LLM_PER_MODEL_MS=20000
LLM_BUDGET_MS=40000

# --- Account ---------------------------------------------------------------
STARTING_BALANCE=100
FUTURES_LEVERAGE=3
RISK_PER_TRADE=0.02
MAX_OPEN_POSITIONS=3
MAX_POSITION_FRACTION=1.5
# Halts new entries at this drawdown from peak equity.
MAX_DRAWDOWN=0.3

# --- Binance fees (USDⓈ-M, VIP 0). Lower if your tier or BNB discount differs.
FUTURES_MAKER_FEE=0.0002
FUTURES_TAKER_FEE=0.0005
# Maintenance margin for symbols outside the built-in majors table.
FUTURES_DEFAULT_MMR=0.01
# fapi.binance.com returns 451 from Vercel's US regions; www proxies the same
# routes and answers there. Order matters — first reachable host wins.
BINANCE_FUTURES_HOSTS=https://www.binance.com,https://fapi.binance.com

# --- Universe and analysis -------------------------------------------------
UNIVERSE_SIZE=10
ANALYSIS_TIMEFRAMES=5m,15m,1h,4h,1d
EXCLUDE_SYMBOLS=USDCUSDT,BUSDUSDT,FDUSDUSDT,TUSDUSDT

# --- Promotion guardrails for the LLM loop ---------------------------------
IMPROVE_MIN_TRADES=12
IMPROVE_MAX_DRAWDOWN=0.35
IMPROVE_MIN_DELTA=0.05

# --- Optional login --------------------------------------------------------
# Leave AUTH_PASSWORD unset for an open deployment (no login screen).
# Set both to enable the login gate.
# AUTH_PASSWORD=
# SESSION_SECRET=
