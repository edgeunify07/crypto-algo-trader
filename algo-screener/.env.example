# ---------------------------------------------------------------------------
# Copy to .env and edit. Shell exports override anything set here.
# Every value below is optional — the defaults run a paper account on public
# Binance market data with no credentials at all.
# ---------------------------------------------------------------------------

# --- LLM self-improvement --------------------------------------------------
# Without this, `improve` falls back to local random-mutation search.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
LLM_CANDIDATES=4

# --- Binance ---------------------------------------------------------------
# Market data needs no key. data-api.binance.vision is the public mirror and is
# used automatically when the main host returns HTTP 451 (geo-restriction).
BINANCE_REST_HOSTS=https://api.binance.com,https://data-api.binance.vision
BINANCE_WS_HOSTS=wss://stream.binance.com:9443,wss://data-stream.binance.vision

# Only needed for `live`. Keep these out of version control.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Universe --------------------------------------------------------------
# Leave SYMBOLS empty to auto-discover the top pairs by 24h quote volume.
SYMBOLS=
QUOTE_ASSET=USDT
UNIVERSE_TOP_N=30
MIN_QUOTE_VOLUME_24H=50000000

# Timeframes analysed, and the subset allowed to anchor a trade.
TIMEFRAMES=1m,3m,5m,15m,30m,1h,2h,4h,6h,12h,1d,3d,1w
TRADE_TIMEFRAMES=15m,30m,1h,4h,1d
HISTORY_BARS=750

# --- Account & costs -------------------------------------------------------
STARTING_CASH=10000
FEE_RATE=0.001
SLIPPAGE_RATE=0.0005

# --- Risk limits (enforced outside the LLM's reach) ------------------------
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=5
MAX_POSITION_FRACTION=0.25
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.2
ONE_TRADE_PER_SYMBOL=true

# --- Improvement guardrails ------------------------------------------------
VALIDATION_FRACTION=0.3
MIN_IMPROVEMENT=0.05
MIN_TRADES=20
MAX_ACCEPTABLE_DRAWDOWN=0.25

# --- Runtime ---------------------------------------------------------------
# LIVE_TRADING=true is required, in addition to API keys, before any real order
# is ever sent. Leave it false unless you mean it.
LIVE_TRADING=false
SCAN_INTERVAL_SEC=30
IMPROVE_INTERVAL_HOURS=0
HTTP_PORT=4317
LOG_LEVEL=info
