# ---------------------------------------------------------------------------
# TEMPLATE ONLY — never put real values in this file. It is tracked by git, so
# anything written here is published to the repository and its history.
#
# Copy to .env (which .gitignore excludes) and fill it in there:
#     cp .env.example .env
#
# For the Vercel app, set these in Vercel -> Settings -> Environment Variables
# and tick Production, Preview AND Development. Vercel only applies new
# variables on a fresh deployment, so redeploy afterwards.
# ---------------------------------------------------------------------------

# --- LLM strategy improvement ----------------------------------------------
# Without a key, `improve` falls back to local random-mutation search.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free
# Models are hedged, not tried in turn: the primary starts at once and each
# failover starts LLM_HEDGE_DELAY_MS later, against one shared deadline, and
# the first valid proposal wins. Measured on the free tier, the 550B primary
# routinely overran a 20s slice while the 120B answered in about 13s, so
# sequential failover left too little time for the model that would have
# answered and rounds returned nothing. Keep LLM_BUDGET_MS inside Vercel's 60s
# function limit with room for the backtests either side.
LLM_BUDGET_MS=44000
LLM_HEDGE_DELAY_MS=7000
# Optional per-request cap; defaults to the whole remaining budget.
# LLM_PER_MODEL_MS=

# Alternative provider for the standalone CLI.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
LLM_CANDIDATES=4

# --- Durable state (required by the Vercel app) ----------------------------
# Without these the app falls back to in-memory storage and every serverless
# invocation starts blank. Vercel -> Storage -> Upstash Redis injects both.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Scheduler auth --------------------------------------------------------
# A long random string. Vercel Cron sends it as `Authorization: Bearer <value>`.
# Use the same value for the GitHub Actions CRON_SECRET repository secret.
CRON_SECRET=

# --- Binance ---------------------------------------------------------------
# Market data needs no key.
# Spot (standalone CLI): data-api.binance.vision is the public mirror, used
# automatically when the main host returns HTTP 451 from a restricted region.
BINANCE_REST_HOSTS=https://api.binance.com,https://data-api.binance.vision
BINANCE_WS_HOSTS=wss://stream.binance.com:9443,wss://data-stream.binance.vision
# Futures (Vercel app): fapi returns 451 from Vercel's US regions; www proxies
# the same routes and answers there, so it is tried first.
BINANCE_FUTURES_HOSTS=https://www.binance.com,https://fapi.binance.com

# Only needed for real order placement. Keep these out of version control.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Account ---------------------------------------------------------------
STARTING_BALANCE=100
FUTURES_LEVERAGE=3
RISK_PER_TRADE=0.02
MAX_OPEN_POSITIONS=3
MAX_POSITION_FRACTION=1.5
# Halts new entries at this drawdown from peak equity.
MAX_DRAWDOWN=0.3

# --- Binance fees (USDⓈ-M, VIP 0). Lower if your tier or BNB discount differs.
FUTURES_MAKER_FEE=0.0002
FUTURES_TAKER_FEE=0.0005
# Maintenance margin for symbols outside the built-in majors table.
FUTURES_DEFAULT_MMR=0.01

# --- Universe and analysis -------------------------------------------------
UNIVERSE_SIZE=10
ANALYSIS_TIMEFRAMES=5m,15m,1h,4h,1d
EXCLUDE_SYMBOLS=USDCUSDT,BUSDUSDT,FDUSDUSDT,TUSDUSDT

# Standalone CLI universe settings.
SYMBOLS=
QUOTE_ASSET=USDT
UNIVERSE_TOP_N=30
MIN_QUOTE_VOLUME_24H=50000000
HISTORY_BARS=750

# --- Improvement guardrails ------------------------------------------------
IMPROVE_MIN_TRADES=12
IMPROVE_MAX_DRAWDOWN=0.35
IMPROVE_MIN_DELTA=0.05

# --- Optional login --------------------------------------------------------
# Leave AUTH_PASSWORD empty for an open deployment (no login screen).
AUTH_PASSWORD=
SESSION_SECRET=
