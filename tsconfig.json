{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "scratch",
    // `algo-screener` is a separate standalone project with its own
    // tsconfig and its own dependencies (ws, @anthropic-ai/sdk). Vercel runs
    // `npm i` only at the repo root, so those are absent there and the Next
    // build's type-check step fails on files it should never have compiled.
    // It builds and tests itself via algo-screener/tsconfig.json.
    "algo-screener"
  ]
}
